# ==============================================================================
# CodeMentor AI - Environment Configuration Template (Zero-DB Public Deployment)
# ==============================================================================

# Backend Server Port (Provided automatically by Cloud Run, Render, Railway, Heroku)
PORT=8080

# Google Gemini API Key (Server-Side Spring Boot Isolation ONLY - never expose to frontend)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OpenRouter API Key (Server-Side Spring Boot Isolation ONLY for AI Programming Mentor)
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Security & Stateless JWT Secret (minimum 256-bit secret)
JWT_SECRET=CodeMentorAISecretKeyForJwtTokenGeneration2026Secure256BitsMinimum

# Production CORS Allowed Origins (Comma-separated URLs of deployed frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.app
APP_URL=http://localhost:5173

# Frontend API Base URL (Pointing to separately hosted Spring Boot REST backend)
# In development: http://localhost:8080/api
# In production: https://your-backend-api.app/api or relative /api if reverse-proxied
VITE_API_BASE_URL=http://localhost:8080/api


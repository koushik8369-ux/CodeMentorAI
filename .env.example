# ==============================================================================
# CodeMentor AI - Environment Configuration Template
# ==============================================================================

# Database Connection (Hosted PostgreSQL e.g., Neon, Supabase, Cloud SQL, AWS RDS)
# Format: jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
# For local offline development: jdbc:postgresql://localhost:5432/codementor_db
DB_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Security & Authentication (minimum 256-bit secret)
JWT_SECRET=YOUR_SECURE_SECRET

# Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Frontend API Base URL (Pointing to Spring Boot REST backend)
VITE_API_BASE_URL=http://localhost:8080/api

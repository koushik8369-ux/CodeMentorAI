# ==============================================================================
# CodeMentor AI - Environment Configuration Template (Database-Free)
# ==============================================================================

# Google Gemini API Key (Server-Side Spring Boot Isolation)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Security & Stateless JWT Secret (minimum 256-bit secret)
JWT_SECRET=CodeMentorAISecretKeyForJwtTokenGeneration2026Secure256BitsMinimum

# Frontend API Base URL (Pointing to Spring Boot REST backend)
VITE_API_BASE_URL=http://localhost:8080/api

# CORS Allowed Origin
APP_URL=http://localhost:5173
